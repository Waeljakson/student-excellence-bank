# Neon PostgreSQL pooled connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/excellence_bank?sslmode=require"

# Neon Auth branch URL
NEON_AUTH_BASE_URL="https://your-branch.neonauth.REGION.aws.neon.tech/excellence_bank/auth"

# 32+ char secret for signed auth session cache cookies
NEON_AUTH_COOKIE_SECRET="replace-with-a-long-random-secret"

# Long random secret used to sign QR tokens
QR_SIGNING_SECRET="replace-with-at-least-32-random-characters"

# Public application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
